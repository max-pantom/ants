{
  "name": "ants",
  "version": "0.1.0",
  "description": "Named agents with their own chats, memory and screens on one machine you own.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ants": "bin/ants.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/main.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node bin/ants.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "croner": "^10.0.1",
    "dompurify": "^3.4.16",
    "hono": "^4.13.12",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "files": [
    "bin",
    "dist",
    "plugins",
    "LICENSE",
    "README.md"
  ]
}
